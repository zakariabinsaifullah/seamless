                            "fontStyle": "normal",
                            "fontFamily": "\"Quarto\""
                        },
                        {
                            "src": ["file:./assets/fonts/quarto/Quarto-LightItalic.woff2"],
                            "fontWeight": "300",
                            "fontStyle": "italic",
                            "fontFamily": "\"Quarto\""
                        },
                        {
                            "src": ["file:./assets/fonts/quarto/Quarto-Medium.woff2"],
