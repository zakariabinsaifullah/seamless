        "layout": {
            "contentSize": "1310px",
            "wideSize": "1440px"
        },
        "shadow": {
            "defaultPresets": false,
            "presets": [
                {
                    "name": "Default Shadow",
                    "shadow": "0 0 11.5px 0 #3C5343",
                    "slug": "seam-shadow"
                }
            ]
        },
        "useRootPaddingAwareAlignments": true
    },
    "styles": {
        "blocks": {
            "core/avatar": {
                "border": {
                    "radius": "100px"
                }
            },
            "core/button": {
                "variations": {
                    "link": {
                        "border": {
                            "bottom": {
                                "color": "currentColor",
                                "style": "solid",
                                "width": "1px"
                            },
                            "color": "transparent",
                            "radius": "0px",
                            "style": "none",
                            "width": "0"
                        },
                        ":hover": {
                            "color": {
                                "text": "var(--wp--preset--color--seam-outer-space)"
                            }
                        },
                        "color": {
                            "background": "transparent",
                            "text": "#538988"
                        },
                        "css": "background: transparent !important;",
                        "spacing": {
                            "padding": {
                                "bottom": "0",
                                "left": "0",
                                "right": "0",
                                "top": "0"
                            }
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    },
                    "alternative": {
                        "border": {
                            "radius": "4px"
                        },
                        "color": {
                            "background": "var(--wp--preset--color--seam-primary)",
                            "text": "var(--wp--preset--color--seam-outer-space)"
                        },
                        "spacing": {
                            "padding": {
                                "bottom": "4px",
                                "left": "28px",
                                "right": "28px",
                                "top": "4px"
                            }
                        },
                        ":hover": {
                            "color": {
                                "background": "var(--wp--preset--color--seam-shadow)",
                                "text": "var(--wp--preset--color--seam-white)"
                            }
                        }
                    },
                    "outline": {
                        "border": {
                            "color": "#000000",
                            "radius": "100px",
                            "style": "solid",
                            "width": "1px"
                        },
                        "color": {
                            "background": "transparent",
                            "text": "#000000"
                        },
                        "spacing": {
                            "padding": {
                                "bottom": "4px",
                                "left": "28px",
                                "right": "28px",
                                "top": "4px"
                            }
                        },
                        ":hover": {
                            "border": {
                                "color": "var(--wp--preset--color--seam-shadow)"
                            },
                            "color": {
                                "text": "var(--wp--preset--color--seam-shadow)"
                            }
                        }
                    }
                }
            },
            "core/buttons": {
                "spacing": {
                    "blockGap": "16px"
                }
            },
            "core/code": {
                "color": {
                    "background": "var(--wp--preset--color--seam-neutral-lightest)",
                    "text": "var(--wp--preset--color--seam-neutral-darkest)"
                },
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--seam-40)",
                        "left": "var(--wp--preset--spacing--seam-40)",
                        "right": "var(--wp--preset--spacing--seam-40)",
                        "top": "var(--wp--preset--spacing--seam-40)"
                    }
                },
                "typography": {
                    "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
                    "fontSize": "var(--wp--preset--font-size--seam-medium)",
                    "fontWeight": "300"
                }
            },
            "core/columns": {
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--seam-50)"
                }
            },
            "core/comment-author-name": {
                "color": {
                    "text": "var(--wp--preset--color--seam-neutral-dark)"
                },
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "color": {
                            "text": "var(--wp--preset--color--seam-neutral-dark)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "spacing": {
                    "margin": {
                        "bottom": "0px",
                        "top": "5px"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-small)"
                }
            },
            "core/comment-content": {
                "spacing": {
                    "margin": {
                        "bottom": "var(--wp--preset--spacing--seam-30)",
                        "top": "var(--wp--preset--spacing--seam-30)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-medium)"
                }
            },
            "core/comment-date": {
                "color": {
                    "text": "var(--wp--preset--color--seam-neutral-darkest)"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--seam-neutral-darkest)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-small)"
                }
            },
            "core/comment-edit-link": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--seam-neutral-darkest)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-small)"
                }
            },
            "core/comment-reply-link": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--seam-neutral-darkest)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-small)"
                }
            },
            "core/comments-pagination": {
                "spacing": {
                    "margin": {
                        "bottom": "var(--wp--preset--spacing--seam-40)",
                        "top": "var(--wp--preset--spacing--seam-40)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-medium)"
                }
            },
            "core/comments-pagination-next": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-medium)"
                }
            },
            "core/comments-pagination-numbers": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-medium)"
                }
            },
            "core/comments-pagination-previous": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-medium)"
                }
            },
            "core/list": {
                "css": "& li{margin-top: 0.5rem;}"
            },
            "core/navigation": {
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-medium)"
                }
            },
            "core/paragraph": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--neue-haas-display-pro)",
                    "fontSize": "var(--wp--preset--font-size--seam-large)",
                    "lineHeight": "1.5"
                },
                "color": {
                    "text": "var(--wp--preset--color--seam-neutral-dark)"
                }
            },
            "core/post-comments-form": {
                "css": "& textarea, input:not([type=submit]){border-radius:.25rem; border-color: var(--wp--preset--color--seam-neutral-lighter) !important;} & input[type=checkbox]{margin:0 .2rem 0 0 !important;} & label {font-size: var(--wp--preset--font-size--seam-small); }",
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--seam-40)",
                        "top": "var(--wp--preset--spacing--seam-40)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-medium)"
                }
            },
            "core/post-date": {
                "color": {
                    "text": "var(--wp--preset--color--seam-neutral-dark)"
                },
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "color": {
                            "text": "var(--wp--preset--color--seam-neutral-dark)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-small)"
                }
            },
            "core/post-navigation-link": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-medium)"
                }
            },
            "core/post-terms": {
                "css": "& a { white-space: nowrap; }",
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-small)",
                    "fontWeight": "600"
                }
            },
            "core/post-title": {
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "none"
                            }
                        },
                        "typography": {
                            "fontWeight": "300",
                            "lineHeight": "1.2",
                            "textDecoration": "none"
                        }
                    }
                }
            },
            "core/pullquote": {
                "css": "& p:last-of-type {margin-bottom: var(--wp--preset--spacing--seam-30);}",
                "elements": {
                    "cite": {
                        "typography": {
                            "fontSize": "var(--wp--preset--font-size--seam-small)",
                            "fontStyle": "normal"
                        }
                    }
                },
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--seam-30)",
                        "top": "var(--wp--preset--spacing--seam-30)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-heading-four)",
                    "fontWeight": "300",
                    "lineHeight": "1.2"
                }
            },
            "core/query-pagination": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--seam-medium)",
                    "fontWeight": "500"
                }
            },
            "core/quote": {
                "border": {
                    "color": "currentColor",
                    "style": "solid",
                    "width": "0 0 0 2px"
                },
                "css": "&.has-text-align-right { border-width: 0 2px 0 0; } &.has-text-align-center { border-width: 0;border-inline: 0; padding-inline: 0; }",
                "elements": {
                    "cite": {
                        "css": "& sub { font-size: 0.65em }",
                        "typography": {
                            "fontSize": "var(--wp--preset--font-size--seam-small)",
                            "fontStyle": "normal",
                            "fontWeight": "300"
                        }
                    }
                },
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--seam-30)",
                    "margin": {
                        "left": "0",
                        "right": "0"
